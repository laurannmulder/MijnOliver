# Supabase-project van MijnOliver (het portaal is de centrale identiteit).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side: gebruikers uitnodigen/verwijderen. Nooit in de browser.
SUPABASE_SERVICE_ROLE_KEY=

# De eigen URL, gebruikt in uitnodigings- en herstelmails.
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Waar de tegels naartoe wijzen. Lokaal kun je hier een dev-server invullen.
NEXT_PUBLIC_URL_RISK=https://risk.mijnoliver.nl
NEXT_PUBLIC_URL_BB=https://bb.mijnoliver.nl

# Eén sessie over mijnoliver.nl en de subdomeinen. In productie `.mijnoliver.nl`
# (met punt ervoor), en exact dezelfde waarde bij elke tool. Lokaal leeg laten.
NEXT_PUBLIC_COOKIE_DOMAIN=
